# --- Required ---
DATABASE_URL=postgresql://user:password@localhost:5432/utsav
# Use 32+ random characters:  openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars

# First admin account. It is created only once, when the database has no admin yet.
# Username defaults to ADMIN_EMAIL, so the old "email + password" login keeps working.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
# ADMIN_USERNAME=admin

# --- Optional ---
PORT=3000
CORS_ORIGIN=http://localhost:4200
# Reminder dates/times are read in this timezone (IANA name). Default: Asia/Kolkata
TIMEZONE=Asia/Kolkata
# Sign-in security. A short-lived access token (JWT) is renewed silently with a refresh token,
# so people stay signed in until they sign out.
# ACCESS_TOKEN_MINUTES=15
# SESSION_DAYS=365        # how long a device stays signed in without being used
# Set to 1 when the API runs behind a proxy/host (Render, Railway, nginx) so rate limits work:
# TRUST_PROXY=1
# In production set NODE_ENV=production (JWT_SECRET must then be 32+ characters)

# SMTP (reminder emails are disabled until these are set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
